---
const { tags = [] } = Astro.props
---
<style>
.search {
  display: flex;
  flex-direction: column;
  gap: var(--space-24);
  width: 100%;
  min-width: 0;
  margin: 0 0 var(--space-64);
}

.search__field {
  position: relative;
  min-width: 0;
  max-width: 42rem;
}

.search__icon {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 18px;
  height: 18px;
  pointer-events: none;
  color: var(--color-marginalia);
}

.search__input {
  width: 100%;
  min-height: 3rem;
  padding: var(--space-8) 0 var(--space-8) calc(18px + var(--space-16));
  font: inherit;
  font-size: var(--font-size-lede);
  line-height: 1.4;
  color: var(--color-text-primary);
  background: transparent;
  border: 0;
  border-bottom: var(--border-width) solid var(--color-border);
  border-radius: 0;
  transition: border-color var(--duration) var(--ease-out);
}

.search__input::placeholder {
  color: var(--color-marginalia);
}

.search__input:hover {
  border-color: var(--color-accent);
}

.search__input:focus {
  outline: none;
  border-color: var(--color-accent);
}

.search__input:focus-visible {
  outline: 2px solid var(--color-accent);
  outline-offset: 4px;
}

.search__input::-webkit-search-cancel-button {
  appearance: none;
  width: 14px;
  height: 14px;
  margin-left: var(--space-8);
  background: var(--color-marginalia);
  mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='black' d='M18.3 5.71 12 12.01 5.7 5.7 4.29 7.11 10.59 13.4 4.29 19.7 5.7 21.11 12 14.82 18.3 21.12 19.71 19.71 13.41 13.4 19.71 7.11z'/></svg>") center / contain no-repeat;
  cursor: pointer;
}

.search__filters {
  display: flex;
  flex-direction: column;
  min-width: 0;
  border-bottom: var(--border-width) solid var(--color-border);
}

.search__chips {
  display: flex;
  flex-wrap: nowrap;
  gap: var(--space-32);
  min-width: 0;
  overflow-x: auto;
  scrollbar-width: thin;
}

.search__chip {
  position: relative;
  display: inline-flex;
  flex-shrink: 0;
  cursor: pointer;
}

.search__chip input {
  position: absolute;
  inset: 0;
  margin: 0;
  opacity: 0;
  cursor: pointer;
}

.search__chip-text {
  display: inline-flex;
  align-items: center;
  padding: 0 0 9px;
  font-size: var(--font-size-label);
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  white-space: nowrap;
  color: var(--color-marginalia);
  background: transparent;
  border: 0;
  border-bottom: var(--border-width) solid transparent;
  pointer-events: none;
  transition:
    color var(--duration) var(--ease-out),
    border-color var(--duration) var(--ease-out);
}

.search__chip:hover .search__chip-text {
  color: var(--color-text-primary);
}

.search__chip input:checked + .search__chip-text {
  color: var(--color-text-primary);
  border-bottom-color: var(--color-accent);
}

.search__chip:has(input:focus-visible) .search__chip-text {
  outline: 2px solid var(--color-accent);
  outline-offset: 4px;
}

.search__status {
  margin: 0;
  font-size: var(--font-size-label);
  font-style: italic;
  color: var(--color-marginalia);
}

.search__empty {
  margin: 0;
  max-width: 40rem;
  font-size: var(--font-size-lede);
  line-height: 1.6;
  color: var(--color-excerpt);
}

.search__empty[hidden],
.search__status[hidden] {
  display: none;
}

.pager {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: var(--space-16);
  width: 100%;
}

.pager[hidden] {
  display: none;
}

.pager__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 2.5rem;
  padding: 12px 32px;
  font: inherit;
  font-size: var(--font-size-label);
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-accent);
  background: transparent;
  border: var(--border-width) solid var(--color-accent);
  border-radius: var(--radius);
  cursor: pointer;
  white-space: nowrap;
  transition:
    background-color var(--duration) var(--ease-out),
    color var(--duration) var(--ease-out),
    transform var(--duration-fast) var(--ease-out);
}

.pager__button:hover,
.pager__button:focus-visible {
  background: var(--color-accent);
  color: var(--color-surface);
}

.pager__button:active {
  transform: scale(0.98);
}

.pager__button:disabled {
  color: var(--color-marginalia);
  border-color: var(--color-border);
  background: transparent;
  cursor: not-allowed;
  transform: none;
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

@media (max-width: 800px) {
  .search {
    margin-bottom: var(--space-32);
    gap: var(--space-16);
  }

  .search__field {
    max-width: none;
  }

  .search__chips {
    gap: var(--space-24);
  }
}

@media (prefers-reduced-motion: no-preference) {
  .pager__button:active:not(:disabled) {
    transform: scale(0.98);
  }
}
</style>

<div class="search">
  <div class="search__field">
    <label class="visually-hidden" for="search-title">Buscar artículos</label>
    <svg class="search__icon" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="11" cy="11" r="6.25" fill="none" stroke="currentColor" stroke-width="1.4"></circle>
      <path d="M16.2 16.2 21 21" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square"></path>
    </svg>
    <input
      class="search__input"
      id="search-title"
      type="search"
      name="q"
      placeholder="Buscar artículos"
      autocomplete="off"
    />
  </div>

  <div class="search__filters">
    <p class="visually-hidden" id="tag-filter-label">Etiqueta</p>
    <div
      class="search__chips"
      role="radiogroup"
      aria-labelledby="tag-filter-label"
    >
      <label class="search__chip">
        <input type="radio" name="tag-article" value="" checked>
        <span class="search__chip-text">Todos</span>
      </label>
      {tags.map((tag) => (
        <label class="search__chip">
          <input type="radio" name="tag-article" value={tag}>
          <span class="search__chip-text">{tag}</span>
        </label>
      ))}
    </div>
  </div>

  <p class="search__status" id="search-status" aria-live="polite"></p>
</div>

<slot />

<p class="search__empty" id="search-empty" hidden>
  Ningún artículo coincide con esa búsqueda.
</p>

<nav class="pager" id="search-pager" hidden aria-label="Paginación del archivo">
  <button class="pager__button" type="button" id="pager-prev">Anterior</button>
  <button class="pager__button" type="button" id="pager-next">Siguiente</button>
</nav>

<script>
  import { EventControl } from "@/lib/search.js"

  const eventControl = new EventControl()
  eventControl.init()
  eventControl.applyFilters()
</script>
