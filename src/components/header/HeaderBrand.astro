---
const { linkLogo, nameBrand } = Astro.props
---
<style>
.header__brand {
  display: flex;
  align-items: center;
  min-width: 0;
  color: var(--color-text-primary);
}

.header__logo {
  display: block;
  width: 148px;
  height: 36px;
  flex-shrink: 0;
}

.header__title {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}
</style>

<a class="header__brand" href="/">
  <svg class="header__logo" viewBox="0 0 173 42" aria-hidden="true">
    <use href={linkLogo}></use>
  </svg>
  <span class="header__title">{nameBrand}</span>
</a>
