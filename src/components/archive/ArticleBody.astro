---
import { imageUrl } from "@/lib/wagtail.js"
import { formatDate } from "@/lib/format.js"
import { pickPullQuote, splitArticleHtml } from "@/lib/quote.js"
import PullQuote from "@/components/archive/PullQuote.astro"

const { post } = Astro.props

const titleId = "article-title"
const title = post.title ?? ""
const lede = post.intro ?? ""
const body = post.body ?? ""
const pullQuote = pickPullQuote(body, { title })
const { before, after } = pullQuote ? splitArticleHtml(body) : { before: body, after: "" }
const cover = imageUrl(post.image)
const alt = post.image?.title || post.caption || title
const caption = post.caption ?? ""
const tags = post.tags ?? []
const datetime = post.date || post.meta?.first_published_at
const dateLabel = formatDate(datetime)
const kicker = [tags[0], dateLabel].filter(Boolean).join(" — ")
const author = post.owner
const authorName =
  [author?.first_name, author?.last_name].filter(Boolean).join(" ") ||
  author?.username ||
  ""
const avatar = author?.profile_picture
  ? imageUrl({ url: author.profile_picture })
  : ""
const initial = authorName.trim().charAt(0).toUpperCase()
---
<style>
.article {
  width: 100%;
  max-width: 100%;
  padding: var(--space-64) var(--space-64) var(--space-128);
}

.article__inner {
  display: flex;
  flex-direction: column;
  gap: var(--space-64);
  max-width: var(--max-width-content);
  margin-inline: auto;
  min-width: 0;
}

.article__header {
  display: flex;
  flex-direction: column;
  gap: var(--space-24);
  max-width: 50rem;
  min-width: 0;
}

.article__kicker {
  margin: 0;
  font-size: var(--font-size-label);
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-excerpt);
}

.article__title {
  margin: 0;
  font-family: var(--font-display);
  font-size: var(--font-size-hero);
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -0.02em;
  color: var(--color-text-primary);
  text-wrap: balance;
}

.article__lede {
  margin: 0;
  max-width: 42rem;
  font-size: var(--font-size-lede);
  font-style: italic;
  font-weight: 400;
  line-height: 1.6;
  color: var(--color-excerpt);
}

.article__byline {
  display: flex;
  align-items: center;
  gap: var(--space-16);
  margin: 0;
  padding-top: var(--space-16);
}

.article__avatar {
  display: grid;
  place-items: center;
  overflow: hidden;
  width: 40px;
  height: 40px;
  flex-shrink: 0;
  color: var(--color-marginalia);
  background: #e6e2da;
  border-radius: var(--radius-pill);
}

.article__avatar img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.article__avatar-icon {
  width: 16px;
  height: 16px;
}

.article__avatar-initial {
  font-size: var(--font-size-nav);
  font-weight: 600;
  line-height: 1;
}

.article__author {
  margin: 0;
  font-size: var(--font-size-label);
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: 0.08em;
  color: var(--color-text-primary);
}

.article__media {
  display: flex;
  flex-direction: column;
  gap: var(--space-8);
  width: 100%;
  margin: 0;
}

.article__cover {
  position: relative;
  overflow: hidden;
  width: 100%;
  height: min(819px, 72vh);
  margin: 0;
  background: #e6e2da;
}

.article__cover img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}

.article__desaturate {
  position: absolute;
  inset: 0;
  background: #fff;
  mix-blend-mode: saturation;
  pointer-events: none;
}

.article__caption {
  margin: 0;
  font-size: var(--font-size-nav);
  font-style: italic;
  line-height: 1.4;
  color: var(--color-marginalia);
}

.article__layout {
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  column-gap: var(--space-32);
  align-items: start;
}

.article__main {
  grid-column: 3 / span 7;
  display: flex;
  flex-direction: column;
  gap: var(--space-32);
  max-width: 680px;
  min-width: 0;
}

.article-body {
  min-width: 0;
}

.article-body :global(> *) {
  max-width: 65ch;
}

.article-body :global(p),
.article-body :global(li) {
  margin: 0 0 1.15em;
  font-size: var(--font-size-excerpt);
  font-weight: 400;
  line-height: 1.6;
  color: var(--color-excerpt);
}

.article-body :global(p:last-child),
.article-body :global(li:last-child) {
  margin-bottom: 0;
}

.article-body--lead :global(p:first-child) {
  margin-bottom: 1.4em;
  font-size: var(--font-size-lede);
  line-height: 1.6;
  color: var(--color-text-body);
}

.article-body--lead :global(p:first-child::first-letter) {
  float: left;
  padding: 0.1em 0.12em 0 0;
  font-family: var(--font-display);
  font-size: 3.4em;
  font-weight: 600;
  line-height: 0.78;
  color: var(--color-text-primary);
}

.article-body:not(.article-body--lead) :global(p:first-child::first-letter) {
  float: none;
  padding: 0;
  font: inherit;
}

.article-body :global(h2),
.article-body :global(h3) {
  margin: 1.4em 0 0.6em;
  font-family: var(--font-display);
  font-weight: 600;
  line-height: 1.3;
  color: var(--color-text-primary);
  text-wrap: balance;
}

.article-body :global(h2) {
  font-size: var(--font-size-h2);
}

.article-body :global(h3) {
  font-size: var(--font-size-lede);
}

.article-body :global(a) {
  text-decoration: underline;
  text-underline-offset: 0.18em;
  color: inherit;
  transition: color var(--duration) var(--ease-out);
}

.article-body :global(a:hover),
.article-body :global(a:focus-visible) {
  color: var(--color-kicker);
}

.article-body :global(ul),
.article-body :global(ol) {
  display: flex;
  flex-direction: column;
  gap: var(--space-16);
  margin: 0 0 1.4em;
  padding: 0;
}

.article-body :global(li) {
  position: relative;
  margin: 0;
  padding-left: 1.6em;
}

.article-body :global(li)::before {
  content: "—";
  position: absolute;
  left: 0;
  color: var(--color-text-tertiary);
}

.article-body :global(blockquote) {
  width: 100vw;
  max-width: 100vw;
  margin: var(--space-64) 0;
  margin-left: calc(50% - 50vw);
  padding: var(--space-96) var(--space-64);
  background: var(--color-surface-muted);
}

.article-body :global(blockquote p) {
  max-width: 48rem;
  margin: 0 auto;
  font-family: var(--font-display);
  font-size: var(--font-size-h2);
  font-weight: 600;
  line-height: 1.3;
  text-align: center;
  text-wrap: balance;
  color: var(--color-text-primary);
}

.article-body :global(blockquote p:first-child::first-letter) {
  float: none;
  padding: 0;
  font: inherit;
}

.article-body :global(img) {
  display: block;
  max-width: 100%;
  height: auto;
  margin: var(--space-32) 0;
}

.article-body :global(em),
.article-body :global(i) {
  font-style: italic;
}

.article-body :global(strong),
.article-body :global(b) {
  font-weight: 600;
  color: var(--color-text-primary);
}

.article__footer {
  display: flex;
  align-items: center;
  gap: var(--space-16);
  margin: 0;
  padding-top: var(--space-32);
  border-top: var(--border-width) solid var(--color-border);
}

.article__footer .article__avatar {
  width: 48px;
  height: 48px;
}

.article__footer .article__avatar-icon {
  width: 18px;
  height: 18px;
}

.article__footer-copy {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.article__footer-label {
  margin: 0;
  font-size: var(--font-size-label);
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-text-primary);
}

.article__footer-name {
  margin: 0;
  font-size: var(--font-size-nav);
  font-weight: 500;
  line-height: 1.2;
  color: var(--color-excerpt);
}

@media (prefers-reduced-motion: no-preference) {
  .article__header,
  .article__media,
  .article__main {
    animation: article-enter 0.7s var(--ease-out) both;
  }

  .article__media {
    animation-delay: 80ms;
  }

  .article__main {
    animation-delay: 140ms;
  }
}

@keyframes article-enter {
  from {
    opacity: 0;
    transform: translateY(10px);
  }

  to {
    opacity: 1;
    transform: none;
  }
}

@media (prefers-reduced-transparency: reduce) {
  .article__desaturate {
    display: none;
  }
}

@media (max-width: 1100px) {
  .article__main {
    grid-column: 1 / -1;
    max-width: 40rem;
  }

  .article__title {
    font-size: clamp(2.5rem, 8vw, 4rem);
  }
}

@media (max-width: 800px) {
  .article {
    padding: var(--space-32) var(--space-16) var(--space-64);
  }

  .article__inner {
    gap: var(--space-32);
  }

  .article__header {
    gap: var(--space-16);
  }

  .article__lede {
    font-size: 1.0625rem;
  }

  .article__cover {
    height: auto;
    aspect-ratio: 4 / 3;
  }

  .article-body :global(blockquote) {
    padding: var(--space-48) var(--space-16);
  }

  .article-body :global(blockquote p) {
    font-size: clamp(1.35rem, 5vw, 2rem);
  }
}
</style>

<article class="article">
  <div class="article__inner">
    <header class="article__header">
      {kicker && <p class="article__kicker">{kicker}</p>}
      <h1 class="article__title" id={titleId}>{title}</h1>
      {lede && <p class="article__lede">{lede}</p>}
      {authorName && (
        <div class="article__byline">
          <span class="article__avatar" aria-hidden="true">
            {avatar ? (
              <img src={avatar} alt="" width="40" height="40" />
            ) : initial ? (
              <span class="article__avatar-initial">{initial}</span>
            ) : (
              <svg class="article__avatar-icon" viewBox="0 0 24 24">
                <circle cx="12" cy="8.2" r="3.1" fill="none" stroke="currentColor" stroke-width="1.4"></circle>
                <path d="M5.6 18.8c.9-3.1 3.3-4.8 6.4-4.8s5.5 1.7 6.4 4.8" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square"></path>
              </svg>
            )}
          </span>
          <p class="article__author">Por {authorName}</p>
        </div>
      )}
    </header>

    {cover && (
      <figure class="article__media">
        <div class="article__cover">
          <img
            src={cover}
            alt={alt}
            width={post.image?.width ?? 1600}
            height={post.image?.height ?? 1200}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <span class="article__desaturate" aria-hidden="true"></span>
        </div>
        {caption && <figcaption class="article__caption">{caption}</figcaption>}
      </figure>
    )}

    {before && (
      <div class="article__layout">
        <div class="article__main">
          <div class="article-body article-body--lead" set:html={before} />
        </div>
      </div>
    )}

    {pullQuote && <PullQuote quote={pullQuote} />}

    {(after || authorName) && (
      <div class="article__layout">
        <div class="article__main">
          {after && <div class="article-body" set:html={after} />}

          {authorName && (
            <footer class="article__footer">
              <span class="article__avatar" aria-hidden="true">
                {avatar ? (
                  <img src={avatar} alt="" width="48" height="48" />
                ) : initial ? (
                  <span class="article__avatar-initial">{initial}</span>
                ) : (
                  <svg class="article__avatar-icon" viewBox="0 0 24 24">
                    <circle cx="12" cy="8.2" r="3.1" fill="none" stroke="currentColor" stroke-width="1.4"></circle>
                    <path d="M5.6 18.8c.9-3.1 3.3-4.8 6.4-4.8s5.5 1.7 6.4 4.8" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square"></path>
                  </svg>
                )}
              </span>
              <div class="article__footer-copy">
                <p class="article__footer-label">Escrito por</p>
                <p class="article__footer-name">{authorName}</p>
              </div>
            </footer>
          )}
        </div>
      </div>
    )}
  </div>
</article>
