---
import { imageUrl } from "@/lib/wagtail.js"
import { formatDate, splitArticleHtml } from "@/lib/format.js"
import PullQuote from "@/components/archive/PullQuote.astro"
import "@/styles/article.css"

const { post } = Astro.props

const titleId = "article-title"
const title = post.title ?? ""
const lede = post.intro ?? ""
const body = post.body ?? ""
const pullQuote = (post.quote ?? "").trim()
const { before, after } = pullQuote
  ? splitArticleHtml(body)
  : { before: body, after: "" }
const cover = imageUrl(post.image)
const alt = post.image?.title || post.caption || title
const caption = post.caption ?? ""
const tags = post.tags ?? []
const datetime = post.date || post.meta?.first_published_at
const dateLabel = formatDate(datetime)
const kicker = [tags[0], dateLabel].filter(Boolean).join(" — ")
const author = post.owner
const authorName =
  [author?.first_name, author?.last_name].filter(Boolean).join(" ") ||
  author?.username ||
  ""
const avatar = author?.profile_picture
  ? imageUrl({ url: author.profile_picture })
  : ""
const initial = authorName.trim().charAt(0).toUpperCase()
---


<article class="article">
  <div class="article__inner">
    <header class="article__header">
      {kicker && <p class="article__kicker">{kicker}</p>}
      <h1 class="article__title" id={titleId}>{title}</h1>
      {lede && <p class="article__lede">{lede}</p>}
      {authorName && (
        <div class="article__byline">
          <span class="article__avatar" aria-hidden="true">
            {avatar ? (
              <img src={avatar} alt="" width="40" height="40" />
            ) : initial ? (
              <span class="article__avatar-initial">{initial}</span>
            ) : (
              <svg class="article__avatar-icon" viewBox="0 0 24 24">
                <circle cx="12" cy="8.2" r="3.1" fill="none" stroke="currentColor" stroke-width="1.4"></circle>
                <path d="M5.6 18.8c.9-3.1 3.3-4.8 6.4-4.8s5.5 1.7 6.4 4.8" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square"></path>
              </svg>
            )}
          </span>
          <p class="article__author">Por {authorName}</p>
        </div>
      )}
    </header>

    {cover && (
      <figure class="article__media">
        <div class="article__cover">
          <img
            src={cover}
            alt={alt}
            width={post.image?.width ?? 1600}
            height={post.image?.height ?? 1200}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <span class="article__desaturate" aria-hidden="true"></span>
        </div>
        {caption && <figcaption class="article__caption">{caption}</figcaption>}
      </figure>
    )}

    {pullQuote && !after && <PullQuote quote={pullQuote} />}

    {before && (
      <div class="article__layout">
        <div class="article__main">
          <div class="article-body article-body--lead" set:html={before} />
        </div>
      </div>
    )}

    {pullQuote && after && <PullQuote quote={pullQuote} />}

    {(after || authorName) && (
      <div class="article__layout">
        <div class="article__main">
          {after && <div class="article-body" set:html={after} />}

          {authorName && (
            <footer class="article__footer">
              <span class="article__avatar" aria-hidden="true">
                {avatar ? (
                  <img src={avatar} alt="" width="48" height="48" />
                ) : initial ? (
                  <span class="article__avatar-initial">{initial}</span>
                ) : (
                  <svg class="article__avatar-icon" viewBox="0 0 24 24">
                    <circle cx="12" cy="8.2" r="3.1" fill="none" stroke="currentColor" stroke-width="1.4"></circle>
                    <path d="M5.6 18.8c.9-3.1 3.3-4.8 6.4-4.8s5.5 1.7 6.4 4.8" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square"></path>
                  </svg>
                )}
              </span>
              <div class="article__footer-copy">
                <p class="article__footer-label">Escrito por</p>
                <p class="article__footer-name">{authorName}</p>
              </div>
            </footer>
          )}
        </div>
      </div>
    )}
  </div>
</article>
