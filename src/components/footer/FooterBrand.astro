---
const { name, linkLogo } = Astro.props
---
<style>
.footer__brand {
  display: flex;
  align-items: center;
  min-width: 0;
  color: var(--color-text-primary);
  opacity: 0.72;
  transition: opacity var(--duration) var(--ease-out);
}

.footer__brand:hover,
.footer__brand:focus-visible {
  opacity: 1;
}

.footer__logo {
  display: block;
  width: 148px;
  height: 36px;
  flex-shrink: 0;
}

.footer__title {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}
</style>

<a class="footer__brand" href="/">
  <svg class="footer__logo" viewBox="0 0 173 42" aria-hidden="true">
    <use href={linkLogo}></use>
  </svg>
  <span class="footer__title">{name}</span>
</a>
