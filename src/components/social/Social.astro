---
const { link, label, icon } = Astro.props
---
<style>
a {
  display: flex;
  color: var(--color-marginalia);
  border-radius: 2px;
  transition:
    color var(--duration) var(--ease-out),
    transform var(--duration-fast) var(--ease-out);
}

a:hover,
a:focus-visible {
  color: var(--color-text-primary);
}

a:active {
  transform: scale(0.96);
}

svg {
  width: 28px;
  height: 28px;
  fill: currentColor;
}
</style>

<a href={link} aria-label={label} target="_blank">
    <svg  aria-hidden="true">
      <use href={icon}></use>
    </svg>
</a>
