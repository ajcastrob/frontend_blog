---
const username = import.meta.env.PUBLIC_BUTTONDOWN_USERNAME
const titleId = "newsletter-title"
---
<style>
.newsletter {
  width: 100%;
  max-width: 100%;
  padding: var(--space-32) var(--space-64) var(--space-64);
  scroll-margin-top: 6rem;
}

.newsletter__grid {
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  column-gap: var(--space-32);
  row-gap: var(--space-32);
  max-width: var(--max-width-content);
  margin-inline: auto;
  align-items: start;
}

.newsletter__aside {
  grid-column: 1 / span 2;
  min-width: 0;
  padding-inline-end: var(--space-32);
}

.newsletter__title {
  margin: 0;
  padding-top: 17px;
  border-top: var(--border-width) solid var(--color-border);
  font-family: var(--font-display);
  font-size: var(--font-size-h2);
  font-style: italic;
  font-weight: 400;
  line-height: 1.3;
  color: var(--color-marginalia);
  text-wrap: balance;
}

.newsletter__main {
  grid-column: 3 / span 7;
  display: flex;
  flex-direction: column;
  gap: var(--space-32);
  max-width: 680px;
  min-width: 0;
  margin-top: 10px;
}

.newsletter__form {
  display: flex;
  flex-direction: column;
  gap: var(--space-24);
}

.newsletter__fields {
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: var(--space-32);
  row-gap: var(--space-24);
}

.newsletter__field {
  display: flex;
  flex-direction: column;
  min-width: 0;
  gap: var(--space-8);
}

.newsletter__form label {
  font-size: var(--font-size-label);
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-kicker);
}

.newsletter__form input[type="text"],
.newsletter__form input[type="email"] {
  width: 100%;
  min-height: 2.25rem;
  padding: var(--space-4) 0 var(--space-8);
  font: inherit;
  font-size: 16px;
  line-height: 1.4;
  color: var(--color-text-primary);
  background: transparent;
  border: 0;
  border-bottom: var(--border-width) solid var(--color-border);
  border-radius: var(--radius);
  transition: border-color var(--duration) var(--ease-out);
}

.newsletter__form input:hover {
  border-color: var(--color-accent);
}

.newsletter__form input:focus {
  outline: none;
  border-color: var(--color-accent);
}

.newsletter__form input:focus-visible {
  outline: 2px solid var(--color-accent);
  outline-offset: 4px;
}

.newsletter__actions {
  display: flex;
  justify-content: flex-end;
}

.newsletter__form button {
  display: inline-flex;
  align-items: center;
  padding: 12px 24px;
  font-size: var(--font-size-label);
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-accent);
  background: transparent;
  border: var(--border-width) solid var(--color-accent);
  border-radius: var(--radius);
  white-space: nowrap;
  cursor: pointer;
  transition:
    background-color var(--duration) var(--ease-out),
    color var(--duration) var(--ease-out),
    transform var(--duration-fast) var(--ease-out);
}

.newsletter__form button:hover,
.newsletter__form button:focus-visible {
  background: var(--color-accent);
  color: var(--color-surface);
}

.newsletter__form button:active {
  transform: scale(0.98);
}

.newsletter__pie {
  margin: 0;
  max-width: 65ch;
  font-size: var(--font-size-nav);
  font-style: italic;
  font-weight: 400;
  line-height: 1.4;
  color: var(--color-marginalia);
}




@media (prefers-reduced-motion: no-preference) {
  .newsletter__aside,
  .newsletter__main {
    animation: newsletter-enter 0.7s var(--ease-out) both;
  }

  .newsletter__main {
    animation-delay: 80ms;
  }


}

@keyframes newsletter-enter {
  from {
    opacity: 0;
    transform: translateY(10px);
  }

  to {
    opacity: 1;
    transform: none;
  }
}

@media (max-width: 1100px) {
  .newsletter__grid {
    grid-template-columns: 1fr;
    row-gap: var(--space-24);
  }

  .newsletter__aside,
  .newsletter__main,
  .newsletter__folio {
    grid-column: 1;
    max-width: none;
  }

  .newsletter__aside {
    width: fit-content;
    max-width: 100%;
    padding-inline-end: 0;
  }

  .newsletter__title {
    font-size: clamp(1.75rem, 5vw, 2rem);
  }
}

@media (max-width: 800px) {
  .newsletter {
    padding: var(--space-32) var(--space-16) var(--space-64);
  }

  .newsletter__fields {
    grid-template-columns: 1fr;
  }

  .newsletter__actions {
    justify-content: stretch;
  }

  .newsletter__form button {
    width: 100%;
    justify-content: center;
  }
}
</style>

{username && (
  <section class="newsletter" id="newsletter-section" aria-labelledby={titleId}>
    <div class="newsletter__grid">
      <header class="newsletter__aside">
        <h2 class="newsletter__title" id={titleId}>Newsletter</h2>
      </header>

      <div class="newsletter__main">

        <form
          class="newsletter__form"
          action={`https://buttondown.com/api/emails/embed-subscribe/${username}`}
          method="post"
        >
          <div class="newsletter__fields">
            <div class="newsletter__field">
              <label for="bd-name">Nombre</label>
              <input
                id="bd-name"
                type="text"
                name="metadata__name"
                required
                autocomplete="name"
              />
            </div>
            <div class="newsletter__field">
              <label for="bd-email">Correo</label>
              <input
                id="bd-email"
                type="email"
                name="email"
                required
                autocomplete="email"
              />
            </div>
          </div>
          <input type="hidden" name="embed" value="1" />
          <div class="newsletter__actions">
            <button type="submit">Suscribirme</button>
          </div>
        </form>

        <p class="newsletter__pie">
          Déjanos tu nombre y correo. Te avisamos cuando haya un texto nuevo.
        </p>
      </div>

    </div>
  </section>
)}
