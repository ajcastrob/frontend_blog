{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "oxc"],
  "categories": { "correctness": "error" },
  "ignorePatterns": ["dist"],
  "jsPlugins": ["oxlint-plugin-complexity"],
  "rules": {
    "complexity/complexity": ["warn", { "cyclomatic": 10, "cognitive": 10 }]
  },
  "env": { "builtin": true, "browser": true }
}
